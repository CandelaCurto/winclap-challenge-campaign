# Copy this file to .env (cp .env-template .env) and fill in your values. .env is never committed.
# `make run` loads it; the values below are fake.

# ID of the results Google Sheet: the part of its URL between /d/ and /edit.
SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789abcdefg

# Optional: ID of the review Sheet (rejected_rows, corrected_rows). Without it, the review stays in output/.
REVIEW_SPREADSHEET_ID=1ZyXwVuTsRqPoNmLkJiHgFeDcBa9876543210zyxwvu

# Path to the Google service account JSON key, on your computer.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Only for GitHub Actions, where it is a repo secret: the content of that JSON key as text.
# Locally, use GOOGLE_APPLICATION_CREDENTIALS instead; if both are set, this one wins.
# GOOGLE_CREDENTIALS={"type": "service_account", "project_id": "my-project", ...}

# GITHUB_ACTIONS and GITHUB_STEP_SUMMARY are also read, but GitHub Actions sets them: never set them here.
